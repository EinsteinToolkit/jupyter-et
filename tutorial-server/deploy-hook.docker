FROM python:3.12-alpine

RUN apk add --no-cache docker-cli docker-cli-compose

COPY deploy_hook.py /deploy_hook.py

ENV COMPOSE_FILE=docker-compose.cilogon.yml
ENV COMPOSE_SERVICE=et-cilogon

CMD ["python3", "/deploy_hook.py"]
